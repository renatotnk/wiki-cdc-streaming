# Copy this file to .env and fill in real values.
# .env is never committed (see .gitignore) — this file only documents variable names.

# --- Messaging backend (src/shared/backend_factory.py) ---
MESSAGING_BACKEND=emulator          # emulator | cloud
PUBSUB_PROJECT_ID=cdcstream-local
PUBSUB_EMULATOR_HOST=localhost:8085 # only read when MESSAGING_BACKEND=emulator

# --- Storage backend (src/shared/backend_factory.py) ---
STORAGE_BACKEND=minio                # minio | gcs
BUCKET_NAME=cdcstream-raw

# MinIO — only read when STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# GCS — only read when STORAGE_BACKEND=gcs
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# --- Wikipedia EventStreams source ---
WIKI_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Contact info sent in the request's User-Agent, per Wikimedia's User-Agent
# policy (unset requests get a 403) — required, no default, use your own.
WIKI_STREAM_CONTACT=your-email@example.com

# --- Consumer flush policy ---
CONSUMER_FLUSH_SIZE=500
CONSUMER_FLUSH_INTERVAL_SECONDS=60
